<Window x:Class="UltraUninstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UltraUninstaller.App"
        Title="{l:Tr 'UltraUninstaller'}"
        Height="640" Width="900"
        MinHeight="480" MinWidth="640">

    <DockPanel>
        <!-- Native menu bar: Alt+T for Tools, fully keyboard navigable, read by JAWS like any Windows menu -->
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="{l:Tr 'Main menu'}">
            <MenuItem Header="{l:Tr '_File'}">
                <!-- Language names are written in their own language on purpose (not translated),
                     so someone who can't read the current language can still find their own. -->
                <MenuItem Header="{l:Tr '_Language'}" AutomationProperties.Name="{l:Tr 'Language'}">
                    <MenuItem x:Name="EnglishLanguageMenuItem" Header="_English" IsCheckable="True"
                              Click="EnglishLanguageMenuItem_Click" AutomationProperties.Name="English"/>
                    <MenuItem x:Name="SerbianLanguageMenuItem" Header="_Srpski (latinica)" IsCheckable="True"
                              Click="SerbianLanguageMenuItem_Click" AutomationProperties.Name="Srpski, latinica"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:Tr '_About UltraUninstaller...'}" Click="AboutMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'About UltraUninstaller'}"/>
                <Separator/>
                <MenuItem Header="{l:Tr 'E_xit'}" Click="ExitMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Exit UltraUninstaller'}"/>
            </MenuItem>
            <MenuItem Header="{l:Tr '_Tools'}">
                <MenuItem Header="{l:Tr '_System Health Check...'}" Click="SystemHealthMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Open System Health Check'}"/>
                <Separator/>
                <MenuItem Header="{l:Tr '_Disk Space Analyzer...'}" Click="DiskSpaceAnalyzerMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Open Disk Space Analyzer'}"/>
                <MenuItem Header="{l:Tr '_Registry Cleaner...'}" Click="RegistryCleanerMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Open Registry Cleaner'}"/>
                <MenuItem Header="{l:Tr '_Startup Manager...'}" Click="StartupManagerMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Open Startup Manager'}"/>
                <MenuItem Header="{l:Tr '_Junk Cleaner...'}" Click="JunkCleanerMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Open Junk Cleaner'}"/>
                <Separator/>
                <MenuItem x:Name="ShellIntegrationMenuItem" Header="{l:Tr 'Enable right-click \'Analyze size\' in _Explorer'}"
                          IsCheckable="True" Click="ShellIntegrationMenuItem_Click"
                          AutomationProperties.Name="{l:Tr 'Enable right-click Analyze size in File Explorer'}"/>
            </MenuItem>
        </Menu>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Search row -->
                <RowDefinition Height="*"/>       <!-- Results list -->
                <RowDefinition Height="Auto"/>   <!-- Options row -->
                <RowDefinition Height="Auto"/>   <!-- Action buttons -->
                <RowDefinition Height="Auto"/>   <!-- Status live region -->
                <RowDefinition Height="120"/>     <!-- Step log -->
            </Grid.RowDefinitions>

            <!-- Search row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <Label Content="{l:Tr '_Search installed programs:'}" Target="{Binding ElementName=SearchBox}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <Button x:Name="SearchButton" Content="{l:Tr '_Search'}" DockPanel.Dock="Right" Click="SearchButton_Click"
                        AutomationProperties.Name="{l:Tr 'Search installed programs'}" Width="90"/>
                <Button x:Name="RefreshButton" Content="{l:Tr 'Show _all'}" DockPanel.Dock="Right" Click="RefreshButton_Click"
                        AutomationProperties.Name="{l:Tr 'Show all installed programs'}" Width="90"/>
                <TextBox x:Name="SearchBox" Margin="8,0" VerticalAlignment="Center"
                         AutomationProperties.Name="{l:Tr 'Program name to search for'}"
                         KeyDown="SearchBox_KeyDown"/>
            </DockPanel>

            <!-- Results list -->
            <ListView x:Name="AppListView" Grid.Row="1"
                      AutomationProperties.Name="{l:Tr 'Installed programs'}"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="False"
                      SelectionChanged="AppListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{l:Tr 'Program name'}" Width="260" DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="{l:Tr 'Version'}" Width="90" DisplayMemberBinding="{Binding DisplayVersion}"/>
                        <GridViewColumn Header="{l:Tr 'Publisher'}" Width="160" DisplayMemberBinding="{Binding Publisher}"/>
                        <GridViewColumn Header="{l:Tr 'Estimated size'}" Width="110" DisplayMemberBinding="{Binding EstimatedSizeDisplay}"/>
                        <GridViewColumn Header="{l:Tr 'Install location'}" Width="190" DisplayMemberBinding="{Binding InstallLocation}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <!-- Opens with the Menu/Apps key or Shift+F10 automatically - standard WPF behavior, no extra wiring needed -->
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr '_Uninstall (silent)'}" Click="ContextUninstallSilent_Click"
                                  AutomationProperties.Name="{l:Tr 'Uninstall selected program, silent method'}"/>
                        <MenuItem Header="{l:Tr '_Force uninstall now'}" Click="ContextForceUninstall_Click"
                                  AutomationProperties.Name="{l:Tr 'Force uninstall selected program now'}"/>
                        <Separator/>
                        <MenuItem Header="{l:Tr '_Open install folder'}" Click="ContextOpenFolder_Click"
                                  AutomationProperties.Name="{l:Tr 'Open install folder in File Explorer'}"/>
                        <MenuItem Header="{l:Tr '_Copy uninstall string'}" Click="ContextCopyUninstallString_Click"
                                  AutomationProperties.Name="{l:Tr 'Copy uninstall string to clipboard'}"/>
                        <MenuItem Header="{l:Tr 'Show _details'}" Click="ContextShowDetails_Click"
                                  AutomationProperties.Name="{l:Tr 'Show program details'}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Options row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                <CheckBox x:Name="AllowForceRemovalCheckBox" Content="{l:Tr 'Allow _force removal if silent uninstall fails (recommended for stuck programs)'}"
                          AutomationProperties.Name="{l:Tr 'Allow force removal if silent uninstall fails'}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="UninstallButton" Content="{l:Tr '_Uninstall selected'}" Click="UninstallButton_Click"
                        AutomationProperties.Name="{l:Tr 'Uninstall selected programs'}" IsEnabled="False"/>
            </StackPanel>

            <!-- Live status region: screen readers announce changes here automatically -->
            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,0,0,4" FontWeight="Bold"
                       AutomationProperties.Name="{l:Tr 'Current status'}"
                       AutomationProperties.LiveSetting="Assertive"
                       Text="{l:Tr 'Ready. Search for a program or show all, then select it to uninstall. Press the Menu key on a program for more options.'}"/>

            <!-- Step-by-step log, also readable line by line -->
            <ListBox x:Name="StepLogList" Grid.Row="5"
                     AutomationProperties.Name="{l:Tr 'Uninstall step log'}"/>
        </Grid>
    </DockPanel>
</Window>
