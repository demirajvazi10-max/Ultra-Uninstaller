<Window x:Class="UltraUninstaller.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UltraUninstaller.App"
        Title="{l:Tr 'About UltraUninstaller'}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- A message box can't hold links, so About is a small window: the text is a read-only
         text box (JAWS/NVDA read it line by line with the arrow keys, it gets focus first),
         and each link is a normal button that opens the browser. Escape closes the window. -->
    <StackPanel Margin="18">
        <TextBox x:Name="InfoText" IsReadOnly="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent" FontSize="14"
                 Margin="0,0,0,14"
                 AutomationProperties.Name="{l:Tr 'About UltraUninstaller'}"/>

        <Button Content="{l:Tr 'Support development on _GitHub Sponsors'}" Tag="https://github.com/sponsors/demirajvazi10-max"
                Click="LinkButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                AutomationProperties.Name="{l:Tr 'Support development on GitHub Sponsors'}"
                AutomationProperties.HelpText="https://github.com/sponsors/demirajvazi10-max"/>
        <Button Content="{l:Tr 'Support on _Ko-fi'}" Tag="https://ko-fi.com/ultracreativesuite"
                Click="LinkButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                AutomationProperties.Name="{l:Tr 'Support on Ko-fi'}"
                AutomationProperties.HelpText="https://ko-fi.com/ultracreativesuite"/>
        <Button Content="{l:Tr 'Donate with _PayPal'}" Tag="https://paypal.me/demirajvazi10"
                Click="LinkButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                AutomationProperties.Name="{l:Tr 'Donate with PayPal'}"
                AutomationProperties.HelpText="https://paypal.me/demirajvazi10"/>
        <Button Content="{l:Tr 'Project on Git_Hub'}" Tag="https://github.com/demirajvazi10-max/Ultra-Uninstaller"
                Click="LinkButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                AutomationProperties.Name="{l:Tr 'Project on GitHub'}"
                AutomationProperties.HelpText="https://github.com/demirajvazi10-max/Ultra-Uninstaller"/>
        <Button Content="{l:Tr 'Ultra Creative _Suite on GitHub'}" Tag="https://github.com/demirajvazi10-max/Ultra-Creative-suite"
                Click="LinkButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                AutomationProperties.Name="{l:Tr 'Ultra Creative Suite on GitHub'}"
                AutomationProperties.HelpText="https://github.com/demirajvazi10-max/Ultra-Creative-suite"/>

        <TextBlock x:Name="StatusText" Margin="0,8,0,8" TextWrapping="Wrap"
                   AutomationProperties.Name="{l:Tr 'Current status'}"
                   AutomationProperties.LiveSetting="Assertive"/>

        <Button Content="{l:Tr '_Close'}" IsCancel="True" Click="CloseButton_Click"
                HorizontalAlignment="Right" Padding="16,6"
                AutomationProperties.Name="{l:Tr 'Close'}"/>
    </StackPanel>
</Window>
