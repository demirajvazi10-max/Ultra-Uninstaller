<Window x:Class="UltraUninstaller.App.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup Manager - UltraUninstaller"
        Height="680" Width="1000"
        MinHeight="480" MinWidth="700">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Scan row -->
            <RowDefinition Height="*"/>       <!-- Results list -->
            <RowDefinition Height="Auto"/>   <!-- Action buttons -->
            <RowDefinition Height="Auto"/>   <!-- Status live region -->
            <RowDefinition Height="90"/>       <!-- Step log -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ScanButton" Content="_Scan startup items" Click="ScanButton_Click"
                    AutomationProperties.Name="Scan everything that runs at startup or logon"/>
        </StackPanel>

        <!-- Checks Registry Run, the Startup folder, logon-triggered Scheduled Tasks, and
             services set to Automatic - not just Run keys like most basic tools. -->
        <ListView x:Name="ResultsListView" Grid.Row="1"
                  AutomationProperties.Name="Startup items"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="False"
                  SelectionChanged="ResultsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Source" Width="200" DisplayMemberBinding="{Binding SourceDisplay}"/>
                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding StatusDisplay}"/>
                    <GridViewColumn Header="Trust" Width="220" DisplayMemberBinding="{Binding TrustDisplay}"/>
                    <GridViewColumn Header="Description" Width="250" DisplayMemberBinding="{Binding DescriptionDisplay}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Disable selected" Click="ContextDisableSelected_Click"
                              AutomationProperties.Name="Disable selected startup items"/>
                    <MenuItem Header="_Enable selected" Click="ContextEnableSelected_Click"
                              AutomationProperties.Name="Enable selected startup items"/>
                    <Separator/>
                    <MenuItem Header="Show _details" Click="ContextShowDetails_Click"
                              AutomationProperties.Name="Show details for the selected item"/>
                    <MenuItem Header="_Search online for information about this" Click="ContextSearchOnline_Click"
                              AutomationProperties.Name="Search online for information about the selected item"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="DisableSelectedButton" Content="_Disable selected" Click="DisableSelectedButton_Click"
                    AutomationProperties.Name="Disable selected startup items" IsEnabled="False"/>
            <Button x:Name="EnableSelectedButton" Content="_Enable selected" Click="EnableSelectedButton_Click"
                    AutomationProperties.Name="Enable selected startup items" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontWeight="Bold" Margin="0,0,0,4"
                   AutomationProperties.Name="Current status"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="Press Scan startup items to check the registry, the Startup folder, scheduled tasks, and automatic services."/>

        <ListBox x:Name="StepLogList" Grid.Row="4"
                 AutomationProperties.Name="Enable and disable step log"/>
    </Grid>
</Window>
