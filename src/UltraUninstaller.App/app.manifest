<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="UltraUninstaller.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- highestAvailable rather than requireAdministrator: lets the app still open
             normally (browse/search) without UAC, and only actually needs the elevated
             token for the destructive uninstall/force-removal actions themselves. -->
        <requestedExecutionLevel level="highestAvailable" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Without this, any path over ~260 characters (common in deeply nested folders,
           e.g. under node_modules-style trees) silently fails with confusing "not found"
           errors in Disk Analyzer, Force Delete, and registry backup export - this opts
           the whole app into Windows' long-path support with no code changes needed. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
