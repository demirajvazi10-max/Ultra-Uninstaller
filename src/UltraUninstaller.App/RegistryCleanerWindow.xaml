<Window x:Class="UltraUninstaller.App.RegistryCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UltraUninstaller.App"
        Title="{l:Tr 'Registry Cleaner - UltraUninstaller'}"
        Height="640" Width="920"
        MinHeight="420" MinWidth="640">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ScanButton" Content="{l:Tr '_Scan for issues'}" Click="ScanButton_Click"
                    AutomationProperties.Name="{l:Tr 'Scan the registry for orphaned entries'}"/>
            <!-- Items the user chose to ignore are hidden by default; this shows them again
                 (marked "ignored") so they can be reviewed or un-ignored. -->
            <CheckBox x:Name="ShowIgnoredCheckBox" Content="{l:Tr 'Show _ignored items'}" Margin="16,0,0,0"
                      VerticalAlignment="Center" Click="ShowIgnoredCheckBox_Click"
                      AutomationProperties.Name="{l:Tr 'Show ignored items'}"/>
        </StackPanel>

        <ListView x:Name="ResultsListView" Grid.Row="1"
                  AutomationProperties.Name="{l:Tr 'Registry issues found'}"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="False"
                  SelectionChanged="ResultsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{l:Tr 'Category'}" Width="150" DisplayMemberBinding="{Binding CategoryDisplay}"/>
                    <GridViewColumn Header="{l:Tr 'Name'}" Width="230" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="{l:Tr 'Reason'}" Width="400" DisplayMemberBinding="{Binding Reason}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:Tr '_Remove selected (backed up first)'}" Click="ContextRemoveSelected_Click"
                              AutomationProperties.Name="{l:Tr 'Remove selected registry issues, backed up first'}"/>
                    <MenuItem Header="{l:Tr 'Show _details'}" Click="ContextShowDetails_Click"
                              AutomationProperties.Name="{l:Tr 'Show details for the selected issue'}"/>
                    <MenuItem Header="{l:Tr '_Search online for information about this'}" Click="ContextSearchOnline_Click"
                              AutomationProperties.Name="{l:Tr 'Search online for information about the selected issue'}"/>
                    <Separator/>
                    <MenuItem Header="{l:Tr '_Ignore selected (don\'t report again)'}" Click="ContextIgnoreSelected_Click"
                              AutomationProperties.Name="{l:Tr 'Ignore selected items, do not report them again'}"/>
                    <MenuItem Header="{l:Tr 'S_top ignoring selected'}" Click="ContextStopIgnoringSelected_Click"
                              AutomationProperties.Name="{l:Tr 'Stop ignoring selected items'}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="RemoveSelectedButton" Content="{l:Tr '_Remove selected (backed up first)'}" Click="RemoveSelectedButton_Click"
                    AutomationProperties.Name="{l:Tr 'Remove selected registry issues, backed up first'}" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontWeight="Bold" Margin="0,0,0,4"
                   AutomationProperties.Name="{l:Tr 'Current status'}"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{l:Tr 'Press Scan for issues to check for orphaned Uninstall and Startup registry entries.'}"/>

        <ListBox x:Name="StepLogList" Grid.Row="4"
                 AutomationProperties.Name="{l:Tr 'Removal step log'}"/>
    </Grid>
</Window>
