<Window x:Class="UltraUninstaller.App.DiskAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UltraUninstaller.App"
        Title="{l:Tr 'Disk Space Analyzer - UltraUninstaller'}"
        Height="700" Width="880"
        MinHeight="480" MinWidth="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Path row -->
            <RowDefinition Height="Auto"/>   <!-- Nav buttons -->
            <RowDefinition Height="*"/>       <!-- List -->
            <RowDefinition Height="Auto"/>   <!-- Delete row -->
            <RowDefinition Height="Auto"/>   <!-- Status live region -->
            <RowDefinition Height="90"/>       <!-- Force delete step log -->
        </Grid.RowDefinitions>

        <!-- Path row -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Label Content="{l:Tr '_Folder to analyze:'}" Target="{Binding ElementName=PathBox}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button x:Name="ScanButton" Content="{l:Tr '_Scan'}" DockPanel.Dock="Right" Click="ScanButton_Click"
                    AutomationProperties.Name="{l:Tr 'Scan this folder'}" Width="80"/>
            <TextBox x:Name="PathBox" Margin="8,0" VerticalAlignment="Center"
                     AutomationProperties.Name="{l:Tr 'Folder path to analyze'}"
                     KeyDown="PathBox_KeyDown"/>
        </DockPanel>

        <!-- Nav buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="UpButton" Content="{l:Tr '_Up one level'}" Click="UpButton_Click"
                    AutomationProperties.Name="{l:Tr 'Go up one folder level'}"/>
        </StackPanel>

        <!-- Results list: same ListView+GridView+ContextMenu pattern as the program list on the
             main window, which is confirmed to read and navigate correctly with JAWS. Multi-select
             via Ctrl+Click / Ctrl+Space, same as the program list; Enter or double-click on a single
             selected row drills into that folder. -->
        <ListView x:Name="ResultsListView" Grid.Row="2"
                  AutomationProperties.Name="{l:Tr 'Folder sizes, largest first'}"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="False"
                  KeyDown="ResultsListView_KeyDown"
                  MouseDoubleClick="ResultsListView_MouseDoubleClick"
                  SelectionChanged="ResultsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{l:Tr 'Folder'}" Width="500" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{l:Tr 'Size'}" Width="150" DisplayMemberBinding="{Binding SizeDisplay}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:Tr '_Open this folder'}" Click="ContextOpenFolder_Click"
                              AutomationProperties.Name="{l:Tr 'Open this folder (drill down)'}"/>
                    <Separator/>
                    <MenuItem Header="{l:Tr '_Delete selected (to Recycle Bin)'}" Click="ContextDeleteSelected_Click"
                              AutomationProperties.Name="{l:Tr 'Delete selected folders to Recycle Bin'}"/>
                    <MenuItem Header="{l:Tr '_Force delete selected (for folders that won\'t delete normally)'}" Click="ContextForceDeleteSelected_Click"
                              AutomationProperties.Name="{l:Tr 'Force delete selected folders'}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Delete row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="DeleteSelectedButton" Content="{l:Tr '_Delete selected (to Recycle Bin)'}" Click="DeleteSelectedButton_Click"
                    AutomationProperties.Name="{l:Tr 'Delete selected folders to Recycle Bin'}" IsEnabled="False"/>
            <Button x:Name="ForceDeleteSelectedButton" Content="{l:Tr 'F_orce delete selected (last resort)'}" Click="ForceDeleteSelectedButton_Click"
                    AutomationProperties.Name="{l:Tr 'Force delete selected folders, for folders that will not delete normally'}" IsEnabled="False"/>
        </StackPanel>

        <!-- Live status region -->
        <TextBlock x:Name="StatusText" Grid.Row="4" FontWeight="Bold" Margin="0,0,0,4"
                   AutomationProperties.Name="{l:Tr 'Current status'}"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="{l:Tr 'Enter a folder and press Scan. Select one or more rows (Ctrl+Click or Ctrl+Space) to delete them; press Enter on a row to open that folder.'}"/>

        <!-- Step log for Force Delete's multi-layer attempts (normal delete, image mount cleanup, ownership reset, permanent delete, scheduled-on-restart) -->
        <ListBox x:Name="StepLogList" Grid.Row="5"
                 AutomationProperties.Name="{l:Tr 'Force delete step log'}"/>
    </Grid>
</Window>
