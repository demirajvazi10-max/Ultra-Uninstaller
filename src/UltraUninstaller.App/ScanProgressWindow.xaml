<Window x:Class="UltraUninstaller.App.ScanProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanning..."
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Scanning for folder sizes" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <!-- Live status region: announces "Measuring X (3 of 12)" as the scan progresses -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,8"
                   AutomationProperties.Name="Scan status"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="Starting scan..."/>

        <!-- Determinate progress bar: real percentage, not a spinner, so it's meaningful when read aloud -->
        <ProgressBar x:Name="ScanProgressBar" Grid.Row="2" Height="20" Minimum="0" Maximum="100" Value="0"
                     AutomationProperties.Name="Scan progress"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="_Cancel" Padding="16,6" Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel scan"/>
        </StackPanel>
    </Grid>
</Window>
