<Window x:Class="UltraUninstaller.App.JunkCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Junk Cleaner - UltraUninstaller"
        Height="640" Width="920"
        MinHeight="420" MinWidth="640">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ScanButton" Content="_Scan for junk" Click="ScanButton_Click"
                    AutomationProperties.Name="Scan for junk files that can safely be removed"/>
        </StackPanel>

        <ListView x:Name="ResultsListView" Grid.Row="1"
                  AutomationProperties.Name="Junk categories found"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="False"
                  SelectionChanged="ResultsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Category" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    <GridViewColumn Header="Items" Width="70" DisplayMemberBinding="{Binding FileCount}"/>
                    <GridViewColumn Header="Description" Width="420" DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Clean selected" Click="ContextCleanSelected_Click"
                              AutomationProperties.Name="Clean the selected junk categories"/>
                    <MenuItem Header="Show _details" Click="ContextShowDetails_Click"
                              AutomationProperties.Name="Show details for the selected category"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="CleanSelectedButton" Content="_Clean selected" Click="CleanSelectedButton_Click"
                    AutomationProperties.Name="Clean the selected junk categories" IsEnabled="False"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontWeight="Bold" Margin="0,0,0,4"
                   AutomationProperties.Name="Current status"
                   AutomationProperties.LiveSetting="Assertive"
                   Text="Press Scan for junk to check Temp folders, browser caches, Windows Update leftovers, and similar safe-to-clear locations."/>

        <ListBox x:Name="StepLogList" Grid.Row="4"
                 AutomationProperties.Name="Cleaning step log"/>
    </Grid>
</Window>
